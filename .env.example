# Sanity (create a project at sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token with Editor permission (server only, never expose)
SANITY_WRITE_TOKEN=
# Any long random string; use the same value in the Sanity webhook
SANITY_REVALIDATE_SECRET=
# Resend (resend.com): verify your domain, then use an address on it
RESEND_API_KEY=
CONTACT_FROM="Webcrestio <enquiries@webcrestio.com>"
CONTACT_TO_EMAIL=wonderful@webcrestio.com
NEXT_PUBLIC_SITE_URL=https://webcrestio.com
